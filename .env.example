# Postgres Database (required for all environments)
# For local dev: Create free database at https://neon.tech
# For Vercel: Automatically set by Vercel Postgres integration
POSTGRES_URL=postgresql://user:password@host/database

# Session cookie secret (MUST be at least 32 characters)
# Generate with: openssl rand -base64 32
COOKIE_SECRET=your-secret-key-at-least-32-characters-long-change-this-in-production
