# Authentication Method: 'oauth' or 'app_password'
# Use 'app_password' for local development, 'oauth' for production
AUTH_METHOD=app_password

# AT Protocol OAuth Configuration (for AUTH_METHOD=oauth)
NEXT_PUBLIC_CLIENT_ID=
OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# App Password Configuration (for AUTH_METHOD=app_password)
# Get your app password from: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password-here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PDS Configuration
PDS_URL=https://bsky.social
