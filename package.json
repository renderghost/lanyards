    "@atproto/lex-cli": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/cors": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
