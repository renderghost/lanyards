# Base URL the app is served from. Required for production builds;
# the OAuth client metadata is generated from it.
# Local dev and e2e builds use http://127.0.0.1 loopback automatically.
PUBLIC_BASE_URL=https://next.lanyards.app

# PostHog project key (public, client-side). Leave empty to disable analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
