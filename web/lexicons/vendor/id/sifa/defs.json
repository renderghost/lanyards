{
  "id": "id.sifa.defs",
  "defs": {
    "host": {
      "type": "token",
      "description": "Hosted or moderated the session, including acting as MC, moderator, or host of a podcast or livestream recorded there. Organizing the event itself is recorded as an id.sifa.profile.project whose events field references it, not as a delivery role."
    },
    "author": {
      "type": "token",
      "description": "The named person co-authored the referenced id.sifa.profile.publication."
    },
    "hybrid": {
      "type": "token",
      "description": "Hybrid on-site and remote work."
    },
    "native": {
      "type": "token",
      "description": "Native or bilingual proficiency."
    },
    "onSite": {
      "type": "token",
      "description": "On-site/in-office work."
    },
    "remote": {
      "type": "token",
      "description": "Fully remote work (unspecified scope). Treated as remoteGlobal by AppViews. Prefer the scoped variants for new records."
    },
    "advisor": {
      "type": "token",
      "description": "Advisory role, paid or unpaid, without a board seat or line responsibility."
    },
    "keynote": {
      "type": "token",
      "description": "Gave a keynote address."
    },
    "toolRef": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of a tool item record in the same repo."
        }
      },
      "description": "A reference to one of the owner's tool item records by AT-URI. No CID is required because tool items are mutable records in the same user's repo. Consumers ignore references that do not resolve."
    },
    "trainee": {
      "type": "token",
      "description": "Structured early-career rotation or graduate program."
    },
    "agentRef": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did",
          "description": "DID of the referenced organization or person's atproto account, if one exists. The stable identity: it survives handle and name changes."
        },
        "name": {
          "type": "string",
          "maxLength": 2560,
          "description": "Human-readable label for the organization or person, as it was known when the record was saved. A point-in-time snapshot, not refreshed from a lookup.",
          "maxGraphemes": 256
        },
        "entityRef": {
          "type": "string",
          "format": "uri",
          "description": "Portable, app-neutral identifier for the referenced organization: a Wikidata Q-ID URI, a ROR URI, or an LEI URI, else a resolver URL. Enables deterministic resolution to a canonical entity even before the organization claims an atproto account. Absent for a bare person or a free-text entry."
        }
      },
      "description": "A reference to an organization or person named by a record: a human label plus stable machine anchors. The name is a point-in-time snapshot captured when the record was saved; did and entityRef are the durable identity and should be resolved live. Consumers render the name, and follow did or entityRef to reach the current entity."
    },
    "business": {
      "type": "token",
      "description": "Business and management skills."
    },
    "contract": {
      "type": "token",
      "description": "Fixed-scope engagement as an independent contractor."
    },
    "creative": {
      "type": "token",
      "description": "Creative and design skills."
    },
    "fullTime": {
      "type": "token",
      "description": "Full-time employee of the organization."
    },
    "industry": {
      "type": "token",
      "description": "Industry-specific domain knowledge."
    },
    "language": {
      "type": "token",
      "description": "Superseded. Language proficiency is its own record type, id.sifa.profile.language, so this is no longer offered as a skill category. Retained because removing a published token would break any consumer referencing it."
    },
    "panelist": {
      "type": "token",
      "description": "Participated as a member of a panel."
    },
    "partTime": {
      "type": "token",
      "description": "Part-time employee of the organization."
    },
    "seasonal": {
      "type": "token",
      "description": "Recurring role tied to a season or peak period."
    },
    "security": {
      "type": "token",
      "description": "Security and privacy skills."
    },
    "skillRef": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the id.sifa.profile.skill record."
        }
      },
      "description": "A reference to an id.sifa.profile.skill record by AT-URI. No CID is required because skills are mutable records in the same user's repo."
    },
    "workshop": {
      "type": "token",
      "description": "Led or facilitated a workshop or tutorial."
    },
    "coSpeaker": {
      "type": "token",
      "description": "The named person presented alongside the claimer at the referenced id.sifa.profile.presentationDelivery occasion."
    },
    "colleague": {
      "type": "token",
      "description": "The confirming person worked with the owner of the referenced id.sifa.profile.position at the same organization. Unlike the other relations, the subject record names its owner rather than the confirming person. An organization account can write this too, but it stays a colleague-level confirmation: the organization-verified tier comes only from an id.sifa.org.employmentAttestation in the organization's own repository."
    },
    "community": {
      "type": "token",
      "description": "Community building and developer relations skills."
    },
    "freelance": {
      "type": "token",
      "description": "Solo service provider working with multiple clients on a project basis. No employees."
