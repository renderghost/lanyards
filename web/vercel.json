{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "functions": {
    "api/meta.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/og.ts": {
      "includeFiles": "node_modules/{@resvg/resvg-wasm/index_bg.wasm,@fontsource/dm-sans/files/dm-sans-latin-{400,700}-normal.woff2}"
    }
  },
  "rewrites": [
    {
      "source": "/@:handle",
      "destination": "/api/meta?handle=:handle"
    },
    {
      "source": "/d/:did",
      "destination": "/api/meta?did=:did"
    },
    {
      "source": "/og/p/:did.png",
      "destination": "/api/og?did=:did"
    },
    {
      "source": "/og/default.png",
      "destination": "/api/og"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/oauth-client-metadata.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
