{
  "name": "lanyards-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && vite build",
    "build:e2e": "VITE_E2E=true PUBLIC_BASE_URL=http://127.0.0.1:4173 npm run build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "e2e": "playwright test --trace off",
    "format": "prettier --write .",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && git diff --exit-code src/i18n/locales",
    "size": "tsx scripts/check-bundle-size.ts",
    "lex:pull": "lex-cli pull",
    "lex:gen": "lex-cli generate",
    "lex:check": "lex-cli generate && git diff --exit-code -- src/lexicons && git ls-files --others --exclude-standard -- src/lexicons | (! grep .)",
    "lex:verify": "tsx scripts/verify-lexicons.ts",
    "check:prod": "PUBLIC_BASE_URL=https://ci.lanyards.invalid npm run build && tsx scripts/check-no-e2e.ts"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/bluesky": "^4.0.26",
    "@atcute/bluesky-richtext-segmenter": "^3.0.2",
    "@atcute/client": "^5.1.2",
    "@atcute/identity-resolver": "^2.0.3",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/oauth-browser-client": "^5.1.0",
    "@atcute/tid": "^1.1.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-text": "^5.3.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "downshift": "^9.5.0",
    "lucide-react": "1.61.0",
    "posthog-js": "^1.447.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "0.63.2",
    "simple-icons": "16.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@atcute/lex-cli": "^3.3.0",
    "@atcute/lexicon-doc": "^3.1.0",
    "@atcute/lexicon-resolver": "^1.0.2",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
