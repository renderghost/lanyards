{
  "name": "lanyards-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "PUBLIC_BASE_URL=http://127.0.0.1:4173 npm run build",
