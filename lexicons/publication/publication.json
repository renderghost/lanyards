{
  "lexicon": 1,
  "id": "app.lanyards.publication",
  "defs": {
    "main": {
      "type": "object",
      "description": "A publication venue - a journal, conference proceedings, preprint server, or other venue where scholarly work is published. Examples: Nature, PLOS ONE, arXiv, NeurIPS Proceedings",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 300,
          "description": "Official name of the publication (e.g., 'Nature', 'PLOS ONE', 'arXiv', 'NeurIPS 2024 Proceedings')"
        },
        "type": {
          "type": "string",
          "enum": [
            "journal",
            "proceedings",
            "preprint",
            "repository",
            "book-series",
            "other"
          ],
          "description": "Type of publication venue"
        },
        "issn": {
          "type": "string",
          "description": "International Standard Serial Number (ISSN) - format: 0028-0836"
        },
        "publisher": {
          "type": "ref",
          "ref": "app.lanyards.organization#main",
          "description": "Optional reference to the publishing organization"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Publication's primary website URL"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxLength": 10,
          "description": "Subject areas or disciplines covered by this publication"
        }
      }
    }
  }
}
