{
  "lexicon": 1,
  "id": "app.lanyards.link.work.publication",
  "defs": {
    "main": {
      "type": "object",
      "description": "A publication venue - embedded object representing a journal, conference proceedings, preprint server, or other venue where scholarly work is published",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 300,
          "description": "Official name of the publication (e.g., 'Nature', 'PLOS ONE', 'arXiv', 'NeurIPS 2024 Proceedings')"
        },
        "type": {
          "type": "string",
          "enum": [
            "journal",
            "proceedings",
            "preprint",
            "repository",
            "book-series",
            "other"
          ],
          "description": "Type of publication venue"
        },
        "issn": {
          "type": "string",
          "description": "International Standard Serial Number (ISSN) - format: 0028-0836"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Publication's primary website URL"
        }
      }
    }
  }
}
