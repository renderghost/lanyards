{
  "lexicon": 1,
  "id": "app.lanyards.link.social",
  "defs": {
    "main": {
      "type": "record",
      "description": "Link to a social media or academic profile - combines social networks and academic platforms (max 1 per platform)",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["url", "platform", "createdAt"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "bluesky",
              "twitter",
              "linkedin",
              "mastodon",
              "researchgate",
              "googlescholar",
              "orcid",
              "semble",
              "other"
            ],
            "description": "Platform identifier"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Full URL to the profile"
          },
          "isLocked": {
            "type": "boolean",
            "description": "Whether this link is locked (e.g., Bluesky profile derived from auth)"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when this link was created"
          }
        }
      }
    }
  }
}
