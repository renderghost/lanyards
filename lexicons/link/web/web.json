{
  "lexicon": 1,
  "id": "app.lanyards.link.web",
  "defs": {
    "main": {
      "type": "record",
      "description": "Custom web link to any website (max 3 per profile)",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["url", "createdAt"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Full URL to the website"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "Display title for the link"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "description": "Brief description of what the link points to"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when this link was created"
          }
        }
      }
    }
  }
}
