{
  "lexicon": 1,
  "id": "app.lanyards.actor.biography.affiliation",
  "defs": {
    "main": {
      "type": "record",
      "description": "A professional affiliation with an academic or research organization",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["organizationName", "startDate", "createdAt"],
        "properties": {
          "organizationName": {
            "type": "string",
            "maxLength": 300,
            "description": "Name of the affiliated organization (e.g., 'Stanford University', 'Max Planck Institute')"
          },
          "organizationType": {
            "type": "string",
            "enum": [
              "institution",
              "company",
              "government",
              "other"
            ],
            "description": "Type of organization"
          },
          "role": {
            "type": "string",
            "maxLength": 100,
            "description": "Role or position at the organization (e.g., 'Research Fellow', 'Professor', 'PhD Candidate')"
          },
          "startDate": {
            "type": "string",
            "format": "datetime",
            "description": "Start date of affiliation"
          },
          "endDate": {
            "type": "string",
            "format": "datetime",
            "description": "End date of affiliation (null if current)"
          },
          "isPrimary": {
            "type": "boolean",
            "description": "Whether this is the primary/current affiliation (maximum 1 primary per researcher)"
          },
          "location": {
            "type": "ref",
            "ref": "app.lanyards.actor.biography.location#main",
            "description": "Organization's location"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "Organization's website URL"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when this affiliation record was created"
          }
        }
      }
    }
  }
}
