{
  "lexicon": 1,
  "id": "app.lanyards.actor.biography.identity",
  "defs": {
    "main": {
      "type": "record",
      "description": "Core identity information synced from Bluesky - these fields are locked and cannot be edited within Lanyards",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["did", "handle", "createdAt"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "The user's AT Protocol decentralized identifier (DID)"
          },
          "handle": {
            "type": "string",
            "description": "The user's handle (from Bluesky account)"
          },
          "displayName": {
            "type": "string",
            "maxLength": 64,
            "description": "Display name (from Bluesky profile, locked)"
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL (from Bluesky profile, locked)"
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560,
            "description": "Profile description/bio (from Bluesky profile, locked)"
          },
          "banner": {
            "type": "string",
            "description": "Banner image URL (from Bluesky profile, locked)"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when the identity record was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when the identity was last synced from Bluesky"
          }
        }
      }
    }
  }
}
