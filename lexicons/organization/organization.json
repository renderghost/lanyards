{
  "lexicon": 1,
  "id": "app.lanyards.organization",
  "defs": {
    "main": {
      "type": "object",
      "description": "An organization in the academic ecosystem - can be an institution, publisher, society, or funder. Uses standard identifiers like Ringgold or GRID for institutions",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 300,
          "description": "Organization name (e.g., 'Stanford University', 'Springer Nature', 'Royal Society')"
        },
        "type": {
          "type": "string",
          "enum": [
            "institution",
            "publisher",
            "society",
            "funder",
            "company",
            "government",
            "other"
          ],
          "description": "Type of organization"
        },
        "ringgoldId": {
          "type": "string",
          "description": "Ringgold identifier for the organization (primarily for academic institutions)"
        },
        "gridId": {
          "type": "string",
          "description": "GRID (Global Research Identifier Database) identifier"
        },
        "rorId": {
          "type": "string",
          "description": "ROR (Research Organization Registry) identifier"
        },
        "location": {
          "type": "ref",
          "ref": "app.lanyards.location#main",
          "description": "Organization's primary location"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Organization's website URL"
        },
        "logo": {
          "type": "blob",
          "accept": ["image/png", "image/jpeg", "image/svg+xml"],
          "maxSize": 1000000,
          "description": "Organization logo (PNG, JPEG, or SVG, max 1MB)"
        }
      }
    }
  }
}
